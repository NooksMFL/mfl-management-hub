{
  "manifest_version": 3,
  "name": "FC Nooks Match View 2.5D",
  "description": "Calibrated native pitch bounds, closer ball-following camera, eleven local stadiums and synchronized MFL motion and scores.",
  "version": "1.12.0",
  "content_scripts": [
    {
      "matches": [
        "https://app.playmfl.com/*"
      ],
      "js": [
        "tracking.js",
        "scoreboard.js",
        "stadiums.js",
        "scene.js",
        "camera.js",
        "renderer.js",
        "viewer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.css",
        "assets/selhurst-park.jpg",
        "assets/ironwood-lane.jpg",
        "assets/harbour-park.jpg",
        "assets/wembley.jpg",
        "assets/san-siro.jpg",
        "assets/camp-nou.jpg",
        "assets/craven-cottage.jpg",
        "assets/dripping-pan.jpg",
        "assets/bracken-moor.jpg",
        "assets/sandygate.jpg",
        "assets/minty-stadium.jpg"
      ],
      "matches": [
        "https://app.playmfl.com/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ]
}
