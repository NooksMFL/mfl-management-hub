{
  "manifest_version": 3,
  "name": "FC Nooks Match View 2.5D",
  "description": "Photographic Ironwood Lane stadium overlay, following MFL rendered positions without added motion lag.",
  "version": "1.8.0",
  "content_scripts": [
    {
      "matches": [
        "https://app.playmfl.com/*"
      ],
      "js": [
        "tracking.js",
        "scoreboard.js",
        "scene.js",
        "renderer.js",
        "viewer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.css",
        "assets/ironwood-lane.jpg"
      ],
      "matches": [
        "https://app.playmfl.com/*"
      ]
    }
  ]
}
