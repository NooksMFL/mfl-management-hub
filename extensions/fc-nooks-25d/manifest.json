{
  "manifest_version": 3,
  "name": "FC Nooks Match View 2.5D",
  "description": "Switch between Selhurst Park-inspired, Ironwood Lane and Harbour Park stadiums while following MFL rendered motion.",
  "version": "1.9.0",
  "content_scripts": [
    {
      "matches": [
        "https://app.playmfl.com/*"
      ],
      "js": [
        "tracking.js",
        "scoreboard.js",
        "stadiums.js",
        "scene.js",
        "renderer.js",
        "viewer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.css",
        "assets/selhurst-park.jpg",
        "assets/ironwood-lane.jpg",
        "assets/harbour-park.jpg"
      ],
      "matches": [
        "https://app.playmfl.com/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ]
}
